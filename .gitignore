# ══════════════════════════════════════════════════════
# .gitignore — magnitud19-backend-share / El Pasaje 3D
# ══════════════════════════════════════════════════════

# Bases de datos locales
*.db
*.db-journal
*.db-shm
*.db-wal

# Documentos y PDFs
*.docx
*.pdf
*.xlsx
*.tmp
*.bak
*.old

# HTML sueltos — excluir solo duplicados y archivos con espacios
melomano  - copia.html
coquette .html

# Scripts temporales y de reparación
main_viejo*.py
main_pro.py
fix_*.py
reparar_*.py
rescate_*.py
recuperar_*.py
reforzar_*.py
verificar_*.py
sincronizar_*.py
unificar_*.py
preparar_*.py
seed_*.py
bloque_*.py
ajustar_*.py
actualizar_*.py
activar_*.py
decodificar*.py
hashear_*.py
inventario.py
finanzas.py
pasaje_total.py
inyectar_*.py
cargar_*.py
ver_*.py
elpasaje_v1*.py

# Carpetas de contenido estático
Coquette/
F-Zone/
INDEX/
CatalogoProductos/
app/
inteligencia_financiera/

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.env
venv/
.venv/
*.egg-info/
dist/
build/

# Sistema
.DS_Store
Thumbs.db

# Streamlit
.streamlit/secrets.toml

# Credenciales y datos sensibles
api_key.txt
credenciales_socios.txt
Clientes.txt

# Archivos de datos y respaldos grandes
*.bundle
*.csv
*.json
HolaNotebookLM.txt
inteligencia_financiera

# Subcarpeta duplicada (artefacto de git)
magnitud19-backend-share/

# Excepción: módulos de la arquitectura modular EPCC v2
!modules/inventario.py
!modules/cargar_pedido.py

# Excepción: catálogos web (JSON públicos servidos por GitHub Pages)
!exports/
!exports/*.json
